# ─────────────────────────────────────────────────────────────────────
# Configuration de Caffein
#   Docker   : copiez ce fichier en .env à côté de docker-compose.yml
#   Linux    : /etc/caffein/caffein.env (créé par install.sh)
#   Local    : .env à la racine du projet (créé par start.sh)
# Toutes les variables sont optionnelles. Après modification : redémarrez le service.
# ─────────────────────────────────────────────────────────────────────

# ── Serveur ──────────────────────────────────────────────────────────
# Adresse publique de l'instance (liens dans les emails, cookies sécurisés si https)
CAFFEIN_APP_URL=http://localhost:8000
# Interface et port d'écoute (127.0.0.1 = accessible uniquement via un reverse proxy local)
CAFFEIN_HOST=127.0.0.1
CAFFEIN_PORT=8000
# Dossier des données (base SQLite, documents, clé de chiffrement, sauvegardes)
# CAFFEIN_DATA_DIR=/var/lib/caffein
CAFFEIN_TIMEZONE=Europe/Paris
# Derrière un reverse proxy distant (autre machine / conteneur), son adresse IP ou * :
# CAFFEIN_FORWARDED_ALLOW_IPS=127.0.0.1

# Mode démonstration : données d'exemple + bouton « Accès démo » sans mot de passe.
# Uniquement pour une instance de présentation : toute personne peut entrer.
CAFFEIN_DEMO=0

# Lien vers le code source de la version qui tourne (AGPL-3.0, section 13).
# Si vous modifiez Caffein et l'ouvrez à d'autres via le réseau, pointez vers VOTRE dépôt.
CAFFEIN_SOURCE_URL=https://github.com/moreauremi/caffein

# ── Emails ───────────────────────────────────────────────────────────
# Sans SMTP ni Resend, les emails sont simulés (visibles dans Automatisations → Boîte d'envoi).
CAFFEIN_EMAIL_FROM=factures@example.com
CAFFEIN_EMAIL_FROM_NAME=Caffein
# SMTP (recommandé) — CAFFEIN_SMTP_SECURITY : starttls (port 587), ssl (port 465) ou none
CAFFEIN_SMTP_HOST=
CAFFEIN_SMTP_PORT=587
CAFFEIN_SMTP_USER=
CAFFEIN_SMTP_PASSWORD=
CAFFEIN_SMTP_SECURITY=starttls
# …ou l'API Resend (domaine expéditeur vérifié requis)
RESEND_API_KEY=

# ── IA (Claude, optionnel) ───────────────────────────────────────────
# Lecture des factures (PDF et photos), devis en langage naturel, relances, newsletters.
# Sans clé : heuristiques locales, aucune donnée n'est envoyée à l'extérieur.
ANTHROPIC_API_KEY=
# claude-opus-5-5 par défaut ; claude-haiku-4-5 coûte moins cher
CAFFEIN_AI_MODEL=claude-opus-5-5

# ── Newsletter → actualités (optionnel, IMAP) ────────────────────────
CAFFEIN_IMAP_HOST=
CAFFEIN_IMAP_USER=
CAFFEIN_IMAP_PASSWORD=
CAFFEIN_NEWSLETTER_SENDER=

# ── Sécurité ─────────────────────────────────────────────────────────
# Clé AES-256 des documents (64 caractères hexadécimaux). Vide → générée dans le dossier
# des données au premier lancement (incluse dans « caffein backup »).
CAFFEIN_ENCRYPTION_KEY=
# Durée des sessions en jours
CAFFEIN_SESSION_DAYS=14

# ── Automatisations ──────────────────────────────────────────────────
CAFFEIN_SCHEDULER=1
CAFFEIN_REMINDER_INTERVAL_DAYS=7
